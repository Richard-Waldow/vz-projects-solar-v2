---
import { u } from '../lib/url';
interface Props { eyebrow: string; title: string; lead?: string; crumbs?: { href: string; label: string }[] }
const { eyebrow, title, lead, crumbs } = Astro.props;
---

<section class="phero">
  <div class="container">
    {crumbs && (
      <nav class="crumbs reveal" aria-label="Brotkrümel">
        <a href={u("/")}>Start</a>
        {crumbs.map((c) => (<><span aria-hidden="true">/</span><a href={u(c.href)}>{c.label}</a></>))}
      </nav>
    )}
    <div class="phero-grid">
      <div class="phero-head reveal">
        <span class="eyebrow">{eyebrow}</span>
        <h1 class="display" set:html={title} />
      </div>
      {lead && <p class="lead reveal" style="--d:120ms">{lead}</p>}
    </div>
    <slot />
  </div>
</section>

<style>
  .phero { position: relative; max-width: 1320px; margin: 0 auto; padding: clamp(120px, 13vw, 160px) 0 clamp(40px, 5vw, 64px); border-bottom: 1px solid var(--line); overflow: hidden; }
  .phero::after { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px); background-size: 56px 56px; -webkit-mask-image: radial-gradient(70% 90% at 80% 0%, #000, transparent 75%); mask-image: radial-gradient(70% 90% at 80% 0%, #000, transparent 75%); pointer-events: none; }
  .phero::before { content: ''; position: absolute; top: -30%; right: -15%; width: 60vw; aspect-ratio: 1; max-width: 900px; background: radial-gradient(circle, rgba(217, 164, 65, 0.16), transparent 62%); pointer-events: none; }
  .crumbs { position: relative; display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 28px; font-size: 0.82rem; color: var(--muted); }
  .crumbs a:hover { color: var(--ink); }
  .crumbs a:last-child { color: var(--ink); }
  .phero-grid { position: relative; display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(24px, 5vw, 80px); align-items: end; }
  .phero-head { display: grid; gap: 1.5rem; justify-items: start; }
  .phero .display { font-size: clamp(2.6rem, 5.6vw, 4.8rem); }
  @media (max-width: 900px) { .phero-grid { grid-template-columns: 1fr; } }
</style>
