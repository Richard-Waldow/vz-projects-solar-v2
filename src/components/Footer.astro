---
import { u } from '../lib/url';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { company } from '../data/site';
import { categories } from '../data/products';
const year = new Date().getFullYear();
---

<footer class="ftr on-dark">
  <div class="container">
    <div class="ftr-top">
      <div class="ftr-brand">
        <Logo size="md" gmbh />
        <p>PV-Großhandel für Stadtwerke, Energieversorger, Projektentwickler und das Fachhandwerk. Bundesweit, herstellerunabhängig, in Projektmengen.</p>
        <a href={u("/anfrage")} class="btn btn--sun btn--sm">Projekt anfragen <span class="btn-icon"><Icon name="arrow-up-right" /></span></a>
      </div>

      <div class="ftr-cols">
        <div>
          <h3>Sortiment</h3>
          <ul>{categories.map((c) => <li><a href={u(`/produkte/${c.id}`)}>{c.name}</a></li>)}</ul>
        </div>
        <div>
          <h3>Unternehmen</h3>
          <ul>
            <li><a href={u("/hersteller")}>Hersteller</a></li>
            <li><a href={u("/loesungen")}>Für wen</a></li>
            <li><a href={u("/ueber-uns")}>Über uns</a></li>
            <li><a href={u("/shop")}>Online-Shop <span class="soon">Bald</span></a></li>
          </ul>
        </div>
        <div>
          <h3>Kontakt</h3>
          <ul class="ftr-contact">
            <li><Icon name="pin" /><span>{company.street}<br />{company.city}</span></li>
            <li><Icon name="phone" /><a href={`tel:${company.phoneHref}`}>{company.phone}</a></li>
            <li><Icon name="mail" /><a href={`mailto:${company.email}`}>{company.email}</a></li>
            <li><Icon name="linkedin" /><a href={company.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="ftr-bottom">
      <span>© {year} {company.name} · Ausschließlich für gewerbliche Kunden (B2B)</span>
      <nav aria-label="Rechtliches">
        <a href={u("/impressum")}>Impressum</a>
        <a href={u("/datenschutz")}>Datenschutz</a>
        <a href={u("/agb")}>AGB</a>
      </nav>
    </div>
    <p class="ftr-note">Herstellernamen und Logos sind Marken der jeweiligen Inhaber. Technische Daten ohne Gewähr, maßgeblich ist das jeweils aktuelle Datenblatt des Herstellers.</p>
  </div>
</footer>

<style>
  .ftr { position: relative; z-index: 2; background: var(--paper); color: rgba(241, 238, 231, 0.66); padding: clamp(56px, 7vw, 88px) 0 32px; border-top: 1px solid var(--line); }
  .ftr-top { display: grid; grid-template-columns: 1.1fr 1.6fr; gap: clamp(48px, 6vw, 96px); padding-bottom: 64px; border-bottom: 1px solid var(--line-inv); }
  .ftr-brand { display: grid; gap: 1.6rem; align-content: start; justify-items: start; }
  .ftr-brand p { margin: 0; max-width: 40ch; font-size: 0.95rem; }
  .ftr-cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .ftr h3 { margin: 0 0 1.1rem; font-family: var(--f-mono); font-size: 0.66rem; font-weight: 400; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .ftr ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; font-size: 0.92rem; }
  .ftr ul a { transition: color 0.4s var(--ease); display: inline-flex; align-items: center; gap: 0.5rem; }
  .ftr ul a:hover { color: var(--ink); }
  .ftr-contact li { display: flex; gap: 0.7rem; align-items: flex-start; }
  .ftr-contact :global(svg) { width: 16px; height: 16px; flex: none; margin-top: 4px; color: var(--sun-2); }
  .soon { font-size: 0.58rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; padding: 0.16rem 0.45rem; border-radius: 3px; background: var(--sun-3); color: var(--sun-2); }
  .ftr-bottom { display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap; padding-top: 28px; font-size: 0.82rem; }
  .ftr-bottom nav { display: flex; gap: 1.5rem; }
  .ftr-bottom a:hover { color: var(--ink); }
  .ftr-note { margin: 20px 0 0; font-size: 0.72rem; color: rgba(241, 238, 231, 0.36); max-width: 80ch; }
  @media (max-width: 900px) {
    .ftr-top { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .ftr-cols { grid-template-columns: 1fr 1fr; }
    .ftr-cols > div:last-child { grid-column: 1 / -1; }
  }
</style>
