  .final-glow { position: absolute; inset: 0; background: radial-gradient(60% 70% at 50% 0%, rgba(217, 164, 65, 0.55), rgba(217, 164, 65, 0.12) 45%, transparent 70%), linear-gradient(180deg, transparent 50%, var(--paper)); animation: glow 6s var(--ease) infinite alternate; }
  @keyframes glow { from { opacity: 0.75; } to { opacity: 1; } }
  .final-inner { position: relative; display: grid; justify-items: center; gap: 1.3rem; }
  .final-inner .lead { max-width: 52ch; color: rgba(241, 238, 231, 0.75); }
  .final-sun { width: 40px; height: 40px; color: var(--ink); animation: spin 40s linear infinite; }
  .contact-strip { max-width: 1320px; margin: 0 auto; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .contact-strip > div { display: grid; gap: 0.3rem; padding: 18px var(--gutter); border-left: 1px solid var(--line); font-size: 0.9rem; }
  .contact-strip > div:first-child { border-left: 0; }
  .contact-strip .mono { color: var(--muted); font-size: 0.64rem; letter-spacing: 0.12em; text-transform: uppercase; }
  .contact-strip a:hover { color: var(--sun); }

  @media (max-width: 1000px) {
    .sol-grid, .eco-grid, .range-grid { grid-template-columns: 1fr 1fr; }
    .sol:nth-child(odd) { border-left: 0; }
    .sol:nth-child(n + 3) { border-top: 1px solid var(--line); }
    .eco-cell, .rc { border-left: 1px solid var(--line); border-top: 1px solid var(--line); }
    .eco-cell:nth-child(odd), .rc:nth-child(odd) { border-left: 0; }
    .eco-cell:nth-child(-n + 2), .rc:nth-child(-n + 2) { border-top: 0; }
    .how-head, .quality, .reach-grid { grid-template-columns: 1fr; }
    .how-panel { grid-template-columns: 1fr; min-height: 0; }
    .how-visual { min-height: 440px; border-left: 0; border-top: 1px solid var(--line); }
    .seg-body { grid-template-columns: 1fr; }
    .seg-points { border-left: 0; border-top: 1px solid var(--line); }
    .q-cells, .reach-list { border-left: 0; border-top: 1px solid var(--line); }
    .hero-stats, .contact-strip { grid-template-columns: 1fr 1fr; }
    .hero-stats div:nth-child(3), .contact-strip > div:nth-child(3) { border-left: 0; }
    .hero-stats div:nth-child(n + 3), .contact-strip > div:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }
  @media (max-width: 700px) {
    .ch-grid { grid-template-columns: 1fr; gap: 48px; }
    .ch-lines, .ch-nodes { display: none; }
    .sol-grid { grid-template-columns: 1fr; }
    .sol { border-left: 0; border-top: 1px solid var(--line); }
    .sol:first-child { border-top: 0; }
    .sol-img { aspect-ratio: 16 / 9; }
    .tab { padding: 14px 12px; font-size: 0.85rem; }
    .tab .mono { display: none; }
    .seg-imgs { grid-template-columns: 1fr; }
    .seg-imgs div + div { display: none; }
    .seg-points { grid-template-columns: 1fr; }
    .seg-points li:nth-child(odd) { border-right: 0; }
    .seg-points li:nth-last-child(2) { border-bottom: 1px solid var(--line); }
    .reach-list { grid-template-columns: 1fr 1fr; }
    .rc-body h3 { font-size: 1rem; }
    .eco-grid { grid-template-columns: 1fr; }
    .eco-cell { border-left: 0 !important; border-top: 1px solid var(--line) !important; min-height: 0; }
    .eco-cell:first-child { border-top: 0 !important; }
    .msg { font-size: 0.74rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .w > span { animation: none; }
    .ch-flow { display: none; }
  }
</style>

<script>
  // Manifest: Wörter leuchten nacheinander auf, gekoppelt an den Scrollfortschritt
  const scrub = document.querySelector<HTMLElement>('[data-scrub]');
  if (scrub) {
    const words = [...scrub.querySelectorAll<HTMLElement>('.mw')];
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) words.forEach((w) => w.classList.add('on'));
    else {
      let active = false;
      let ticking = false;
      const update = () => {
        ticking = false;
        const r = scrub.getBoundingClientRect();
        const vh = window.innerHeight;
        const p = Math.min(1, Math.max(0, (vh * 0.85 - r.top) / (r.height * 0.9)));
        const lit = Math.round(p * words.length);
        words.forEach((w, i) => w.classList.toggle('on', i < lit));
      };
      const onScroll = () => { if (active && !ticking) { ticking = true; requestAnimationFrame(update); } };
      new IntersectionObserver(([e]) => { active = e.isIntersecting; if (active) update(); }).observe(scrub);
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  }

  // Tabs mit automatischem Weiterschalten (Fortschrittsbalken), pausiert außerhalb des Viewports
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const auto = root.dataset.tabs === 'how' && !matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    const show = (i: number, focus = false) => {
      current = (i + tabs.length) % tabs.length;
      tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === current)); t.tabIndex = k === current ? 0 : -1; });
      panels.forEach((p, k) => (p.hidden = k !== current));
      if (focus) tabs[current].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') show(current + 1, true);
        if (e.key === 'ArrowLeft') show(current - 1, true);
      });
      if (auto) t.querySelector('.tab-bar i')?.addEventListener('animationend', () => show(current + 1));
    });
    show(0);
    if (auto) {
      root.classList.add('is-paused');
      new IntersectionObserver(([e]) => root.classList.toggle('is-paused', !e.isIntersecting), { threshold: 0.35 }).observe(root);
    } else {
      root.querySelectorAll<HTMLElement>('.tab-bar').forEach((b) => (b.style.display = 'none'));
    }
  });

  // Hintergrundvideos nur abspielen, wenn sichtbar (spart Akku und Daten)
  document.querySelectorAll<HTMLVideoElement>('video[autoplay]').forEach((v) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { v.removeAttribute('autoplay'); v.pause(); return; }
    new IntersectionObserver(([e]) => { if (e.isIntersecting) v.play().catch(() => {}); else v.pause(); }).observe(v);
  });
</script>
